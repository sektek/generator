  "dependencies": {
    "tslib": "^2.8.1",
    "yeoman-generator": "^8.2.2",
    "yeoman-test": "^11.2.0"
  },
  "devDependencies": {
    "@sektek/eslint-plugin": "^2",
    "@sektek/prettier-config": "^2",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.2.3",
    "@types/sinon": "^21.0.0",
    "@types/sinon-chai": "^4.0.0",
    "c8": "^10.1.3",
    "chai": "^6.2.1",
    "chai-as-promised": "^8.0.2",
    "eslint": "^9.39.1",
    "mocha": "^11.7.5",
    "nyc": "^17.1.0",
    "prettier": "^3",
    "sinon": "^21.0.0",
    "sinon-chai": "^4.0.1",
    "tsx": "^4.21.0",
    "typescript": "5.9.3"
  }
