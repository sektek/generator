{
  "name": "@sektek/generator-test",
  "version": "1.0.0",
  "description": "Helpers for testing @sektek generators",
  "author": "Edward Kelly <eddie@sektek.net>",
  "repository": {
    "type": "git",
    "url": "git@github.com:sektek/generator.git"
  },
  "license": "MIT",
  "private": false,
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
